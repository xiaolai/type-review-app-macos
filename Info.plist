<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>            <string>TYPE</string>
  <key>CFBundleDisplayName</key>     <string>TYPE</string>
  <key>CFBundleExecutable</key>      <string>TypeReviewApp</string>
  <key>CFBundleIdentifier</key>      <string>review.type.app</string>
  <key>CFBundleIconFile</key>        <string>TypeReview</string>
  <key>CFBundlePackageType</key>     <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>1.0.1</string>
  <key>CFBundleVersion</key>         <string>1</string>
  <key>LSMinimumSystemVersion</key>  <string>14.0</string>
  <!-- Required by App Store submission, and pointless for the direct build,
       but one Info.plist serves both channels and an extra key costs the
       direct build nothing. -->
  <key>LSApplicationCategoryType</key> <string>public.app-category.education</string>
  <key>NSHumanReadableCopyright</key> <string>Copyright © 2026 type.review contributors. MIT licensed.</string>
  <!-- False, and checked rather than assumed: the app imports no crypto and
       links no Security framework, and the only framework it pulls beyond the
       ordinary set is CoreServices. Declaring it here is what keeps every
       upload from asking the export-compliance question again. -->
  <key>ITSAppUsesNonExemptEncryption</key> <false/>
  <!-- One copy of this build at a time. `open` already activates the running
       instance rather than duplicating it, but `open -n` does not, and two
       processes of the same build means two event taps and every keystroke
       heard twice. Measured: without this, `open -n` yields two.

       This says nothing about the two distribution channels, which carry
       different identifiers and are different applications to the system.
       Those are allowed to run together on purpose — refusing to launch is an
       unexplainable failure, and moving a profile from one to the other needs
       both of them open. `Channel.shouldYieldToSibling` keeps them from
       sounding at once. -->
  <key>LSMultipleInstancesProhibited</key> <true/>
  <key>NSHighResolutionCapable</key> <true/>
</dict>
</plist>
